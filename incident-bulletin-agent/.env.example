# ── LLM ─────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key        # alternative LLM provider
LLM_PROVIDER=anthropic                       # anthropic | openai
LLM_MODEL=claude-sonnet-4-6

# ── Azure AI Search ──────────────────────────────────────────────────────────
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-azure-search-admin-key
AZURE_SEARCH_INDEX=historical-bulletins

# ── External Services ────────────────────────────────────────────────────────
VCC_BASE_URL=https://vcc.internal/api/v1
VCC_API_KEY=your-vcc-api-key
BCU_BASE_URL=https://bcu.internal/api/v1
BCU_API_KEY=your-bcu-api-key

# ── LangSmith Observability ──────────────────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your-langsmith-api-key
LANGCHAIN_PROJECT=incident-bulletin-agent

# ── Prometheus ───────────────────────────────────────────────────────────────
PROMETHEUS_PORT=8001

# ── App ──────────────────────────────────────────────────────────────────────
APP_ENV=development                          # development | staging | production
LOG_LEVEL=INFO
HTTP_TIMEOUT=30
MAX_RETRIES=3
TEMPLATES_DIR=templates
